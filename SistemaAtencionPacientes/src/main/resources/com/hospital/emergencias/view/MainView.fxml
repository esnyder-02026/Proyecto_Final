<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hospital.emergencias.controller.MainController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Registro de Pacientes - Emergencias" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nombre Completo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Edad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEdad" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="DPI:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDPI" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Síntomas:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtSintomas" prefHeight="60" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Prioridad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbPrioridad" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Registrar Paciente" onAction="#handleRegistrar" />
        <Button text="Atender Siguiente" onAction="#handleAtender" />
        <Button text="Actualizar Lista" onAction="#handleActualizar" />
    </HBox>

    <TableView fx:id="tblPacientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPrioridad" text="Prioridad" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colHora" text="Hora de Ingreso" prefWidth="150"/>
            <TableColumn fx:id="colSintomas" text="Síntomas" prefWidth="150.0" />
        </columns>
    </TableView>
</VBox>